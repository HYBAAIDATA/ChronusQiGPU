# Chronus Quantum iGPU v36.0 Environment Variables

# API Configuration
TENANT_ID=
ACCESS_TOKEN=
REGION=us-east-1

# Optional: Override production defaults for development
SKIP_HEAVY_BENCHMARKS=false
ENABLE_MUTATION_TESTING=false

# Database / Storage
# DB_URL=postgresql://localhost:5432/chronus
# STORAGE_PATH=./data

# Security
# JWT_SECRET=
# SESSION_SECRET=

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/chronus.log
