# PYTHIA hybrid solver-fleet image (EHS T10).
# Runs hyba.hybrid (GPUSolver / ASICSolver / HybridCoordinator) plus the
# paired benchmark harness. PoCL provides a real CPU OpenCL fallback; Intel
# runtime support is included where available. ASIC remains fail-closed until
# a real device node is mapped in.
FROM python:3.12-slim-bookworm AS runtime
WORKDIR /app

# The umbrella wheel maps ~30 top-level packages (pyproject package-dir), so a
# partial COPY cannot build it; .dockerignore keeps the context lean.
COPY . .

# Retry transient PyPI/network stalls during in-tree dependency installation.
ENV PIP_DEFAULT_TIMEOUT=120 PIP_RETRIES=10
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ocl-icd-libopencl1 intel-opencl-icd pocl-opencl-icd clinfo \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -c "from pathlib import Path; p=Path('scripts/ci_install.sh'); p.write_bytes(p.read_bytes().replace(bytes([13,10]), bytes([10])))" \
    && PIP_NO_CACHE_DIR=1 bash scripts/ci_install.sh "hardware,dev"

ENV OCL_ICD_VENDORS=/etc/OpenCL/vendors
ENV HYBA_REQUIRE_HYBA=1
ENV PYTHONUNBUFFERED=1

# Benchmark artifacts land in a volume-mountable reports dir.
ENV HYBA_REPORTS_DIR=/app/reports
RUN mkdir -p /app/reports
VOLUME ["/app/reports"]

# Default: paired benchmark on a modest synthetic corpus, labeled SYNTHETIC.
ENTRYPOINT ["python3", "scripts/benchmark_hybrid.py"]
CMD ["--n", "32", "--nonce-space", "65536", "--resamples", "500"]
