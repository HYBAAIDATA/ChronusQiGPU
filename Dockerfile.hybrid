# PYTHIA hybrid solver-fleet image (EHS T10).
# Runs hyba.hybrid (GPUSolver / ASICSolver / HybridCoordinator) plus the
# paired benchmark harness. The image carries vendor-portable OpenCL ICDs:
#   - PoCL    : real CPU OpenCL device — the GPU-solver arm executes on
#               silicon even with no discrete GPU attached.
#   - Intel NEO / ROCm ICDs : picked up when the host exposes /dev/dri.
# ASIC channels are pass-through only: ASICSolver stays fail-closed
# (ASICNotPresent) unless a real device node is mapped in.
FROM python:3.12-slim-bookworm AS runtime
WORKDIR /app

COPY pyproject.toml README.md LICENSE ./
COPY hyba ./hyba
COPY kellogg ./kellogg
COPY toe ./toe
COPY mining ./mining
COPY Intelligence ./Intelligence
COPY scripts/benchmark_hybrid.py ./scripts/benchmark_hybrid.py
COPY tests/test_hybrid_signal.py ./tests/test_hybrid_signal.py

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ocl-icd-libopencl1 intel-opencl-icd pocl-opencl-icd rocm-opencl-icd clinfo \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir ".[hardware,dev]"

ENV OCL_ICD_VENDORS=/etc/OpenCL/vendors
ENV HYBA_REQUIRE_HYBA=1
ENV PYTHONUNBUFFERED=1

# Benchmark artifacts land in a volume-mountable reports dir.
ENV HYBA_REPORTS_DIR=/app/reports
RUN mkdir -p /app/reports
VOLUME ["/app/reports"]

# Default: the paired benchmark on a modest synthetic corpus (labeled
# SYNTHETIC in the artifacts). Override with --headers for a real corpus.
ENTRYPOINT ["python3", "scripts/benchmark_hybrid.py"]
CMD ["--n", "32", "--nonce-space", "65536", "--resamples", "500"]
