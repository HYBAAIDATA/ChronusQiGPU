# Chronus miner environment (copy to .env.miner; never commit real values).
#
# docker-compose loads this file into the miner container only (profile
# "miner"), keeping pool passwords and mining custody keys out of the API
# container. Every key is read by code under src/ (enforced by
# tests/test_wiring_entrypoints.py).

# --- Miner (chronus_live_miner.py; Dockerfile target miner-runtime, compose profile "miner")
# BRAIINS | VIABTC; host/port/user/password are read as MINING_<POOL>_*.
MINING_ACTIVE_POOL=BRAIINS
MINING_BRAIINS_HOST=
MINING_BRAIINS_PORT=
MINING_BRAIINS_USER=
MINING_BRAIINS_PASSWORD=
MINING_MAX_SECONDS=
MINING_NONCE_BATCH=65536
# Pool allowlist (fail-closed): JSON array of the exact endpoints the gateway may
# open, e.g. ["stratum+tcp://pool.example.com:3333"]; the default [] rejects all.
# CHRONUS_ALLOWED_POOL_ENDPOINTS=["stratum+tcp://pool.example.com:3333"]
# Share submission stays disarmed unless explicitly approved. Arming also needs
# the miner's own custody identity (distinct from CHRONUS_MINING_ADMIN_* in .env.example,
# which belongs to the API): tenant ID, signing key file and custody database.
# CHRONUS_MINING_TENANT_ID=
# CHRONUS_MINING_KEY_FILE=/run/secrets/chronus-mining.key
# CHRONUS_MINING_CUSTODY_PATH=/var/lib/chronus/mining-custody.sqlite3
CHRONUS_MINING_SUBMIT_ARMED=0
CHRONUS_MINING_APPROVAL_REFERENCE=
CHRONUS_MINING_ACCEPTED_SHARE_TARGET=0
