# PYTHIA — minimal environment surface.
# Every variable here is read by live code; anything else is dead weight.
# Canonical stack: mla1517_platform_v3.4 (Python control API + mining).
# main.py auto-loads a repo-root .env on boot (process env wins; .env fills gaps).

# --- Control API (main.py / control_api.py) ---
PYTHIA_HOST=0.0.0.0
PYTHIA_PORT=8377
PYTHIA_WEB_ROOT=dist/public
PYTHIA_CORS_ORIGIN=http://localhost:8377
# Auto-spawn mining_runtime + salamander_engine on backend start when
# MLA1517_MMIO_DEVICE is set (supervised, bounded restarts).
PYTHIA_AUTOSTART_WORKERS=1
# Solver arms: independent stratum-bridge processes supervised by the
# control API (octopus model — one brain, N arms). Each arm opens its own
# pool connection and negotiates its own extranonce1, so arms search
# disjoint 2^32 nonce spaces; inside an arm the M32 topology partitions
# every window across 32 lanes. Each arm reports its own measured
# hashrate through the heartbeat metrics sidecar. Raise gradually — every
# arm is a real pool connection and a real CPU/GPU worker.
PYTHIA_SOLVER_ARMS=1

# --- Stratum credentials (sent verbatim to mining.authorize) ---
# Braiins:  userName.workerName — userName = your registered Braiins Pool
#           account name; workerName must match ^[-a-zA-Z0-9_@+:]+$.
#           Password must be NON-EMPTY (Braiins rejects blank authorize
#           passwords; "x" is the convention).
# ViaBTC:   account.worker — official BTC stratums are btc.viabtc.io:3333,
#           btc.viabtc.cc:3333, btc.viabtc.top:3333 (failover port 443).
MLA1517_STRATUM_USER=PYTHIA.001
MLA1517_STRATUM_PASSWORD=123
MLA1517_BRAIINS_ENDPOINT=stratum.braiins.com:3333
MLA1517_VIABTC_ENDPOINT=btc.viabtc.io:3333
PYTHIA_POOL_PROFILE=viabtc

# --- Canonical runtime / hardware gate ---
MLA1517_MODE=mla1517_gpu
MLA1517_GPU_BACKEND=opencl
MLA1517_MMIO_DEVICE=
MLA1517_MMIO_BYTES=8192
MLA1517_DIFFICULTY_MASK=0x3f
MLA1517_BASE_STEP=0
MLA1517_SALAMANDER_ENABLE=1
MLA1517_EUCLIDCORE_ENABLE=1
MLA1517_EUCLIDCORE_SEED=1517
MLA1517_SALAMANDER_FAULT_THRESHOLD=5
MLA1517_POLYHEDRAL_MASK=0x0000FFFF
MLA1517_TELEMETRY_PATH=./data/mla1517_telemetry
MLA1517_PRIME_DB_DIR=./data/prime-db
MLA1517_PRIME_DB_CURSORS=./data/primedb_cursors
MLA1517_PRIME_DB_MAX_STATES=16777216
MLA1517_COORDINATOR_CONTROL_SOCKET=./data/mla1517_coordinator.sock
MLA1517_LIVE_APPROVAL_ID=
MLA1517_SCALING_BATCH_SIZE=1
MLA1517_SCALING_OUTPUT=results/lucas_scaling_measurement.jsonl
MLA1517_LOG_LEVEL=INFO

# Compose-only interpolation (platform multi-service stack):
# MLA1517_UIO_DEVICE=/dev/uio0  MLA1517_PRIME_DB_HOST_DIR=<required>  MLA1517_TELEMETRY_PORT=8080

# --- OpenCL device selection gate ---
# Strict production gate (MLA1517 fabric): refuse anything that is not a
# HYBA-alias device. Dev/laptop override: HYBA_REQUIRE_HYBA=0 plus an
# explicit vendor alias, e.g. HYBA_DEVICE_ALIAS=intel for the UHD 620.
HYBA_REQUIRE_HYBA=1
HYBA_DEVICE_ALIAS=hyba-mla1517,hyba_mla1517,mla1517,hyba
# Exact-identity evidence for the deployment target (UHD 620 example):
# HYBA_DEVICE_VENDOR=Intel
# HYBA_DEVICE_PCI_IDS=0x5917
# HYBA_DEVICE_NAME=Intel(R) Graphics [0x5917]
# Dispatch planning: HYBA_BACKEND=auto (metal/cuda/rocm/opencl/cpu).
# Only opencl executes the SHA-256d kernels today; metal/cuda/rocm/vulkan
# force-requests fail explicitly via hyba.vendors + backend_binding.
# HYBA_BACKEND=auto

# --- Legacy stratum bridge (mining/stratum_bridge.py) ---
# Only needed if you run that path; submission stays triple-gated.
# PYTHIA_POOL_PROFILE selects which pool's endpoint + account pair the
# bridge defaults to; per-pool vars never cross-pair with the other pool.
STRATUM_PASSWORD=123
BRAIINS_ACCOUNT=PYTHAGORAS.PYTHIA
BRAIINS_ENDPOINT=stratum+tcp://stratum.braiins.com:3333
VIABTC_ACCOUNT=PYTHIA.001
VIABTC_ENDPOINT=stratum+tcp://btc.viabtc.io:3333
HYBA_ENABLE_LIVE_SHARE_SUBMIT=false
HYBA_LIVE_SHARE_APPROVAL_ID=
HYBA_AUTONOMOUS_EXTERNAL_ACTIONS=false
HYBA_MAX_RUNTIME_SECONDS=3600
HYBA_TARGET_SHARES=2

# --- Production miner execution path (mining/production_miner.py) ---
# aethel_hendrix (default): AETHEL->Tensor->Hendrix/Pisot->iGPU. The
#   Hendrix schedule assigns PYTHIA_SOLVER_WORKERS independent arms a
#   disjoint coprime position class — the merged order covers the whole
#   window exactly once. workers 1..600 (virtual arms, not processes).
# aethel: FourLayerMiningStack path. direct: raw hasher only.
#PYTHIA_EXECUTION_PATH=aethel_hendrix
#PYTHIA_SOLVER_WORKERS=32

# --- Runtime config file (operator surface; GET/PUT /api/v1/config) ---
# Mutable config-bounded state: pools registry, solver arms/workers,
# deterministic hashrate target (hard ceiling 1 EH/s), live-submit
# approval. Solver arms poll it per window (pacing) and per share submit
# (live gate), so hashrate and live submit take effect without restart;
# pools/solvers changes restart the arms from the control API.
#PYTHIA_RUNTIME_CONFIG=data/runtime_config.json

# --- Hardware profile (Intelligence/hardware_config.py) ---
EUCLID_HARDWARE_PROFILE=auto
EUCLID_MINING_CAP_EHS=1.0
EUCLID_MAX_MEMORY_GB=100
EUCLID_CLOUD_GPU_COUNT=0

# --- TS surface only (server.ts / src/lib — NOT the Python runtime) ---
EUCLID_ADMIN_API_KEY=
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PYTHON_BIN=python
HYBA_KILL_SWITCH=false
