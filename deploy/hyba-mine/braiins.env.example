# Local canonical runner settings. Replace the worker before a live test.
MINING_ACTIVE_POOL=BRAIINS
# A stratum+tcp:// prefix is optional; the fixed parser accepts this bare host.
MINING_BRAIINS_HOST=stratum.braiins.com
MINING_BRAIINS_PORT=3333
MINING_BRAIINS_USER=YOUR_BRAIINS_USERNAME.docker-test
# Braiins ignores this field; x is a placeholder required by the client.
MINING_BRAIINS_PASSWORD=x
# Shared with the API. Unset uses ~/.local/share/hyba-mine/hashrate-cap.
# CHRONUS_HASHRATE_LIMIT_FILE=
MINING_NONCE_BATCH=65536
MINING_MAX_SECONDS=120
