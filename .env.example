# PYTHIA environment.
#
# Two variables are required. Everything else is optional and shown commented
# out with its real default. main.py loads a repo-root .env on boot (the
# process environment wins). `python -m scripts.deploy_sentry` fails CI if
# this file names a variable that no code reads.

# --- Required -----------------------------------------------------------
# Pool worker identity, sent verbatim to mining.authorize (account.worker).
MLA1517_STRATUM_USER=account.worker
# Operator key for every state-changing control request (start, stop,
# switch, elevate, config): Authorization: Bearer <key>. Without it, control
# is closed. Generate one with: openssl rand -hex 32
EUCLID_ADMIN_API_KEY=

# --- Pools ----------------------------------------------------------------
# Pools in failover order, and the primary. Catalog: braiins, viabtc,
# nicehash (needs an endpoint), ckpool.
# PYTHIA_POOLS=braiins,viabtc
# PYTHIA_POOL_PROFILE=braiins
# The primary's password and endpoint (default: x, and the catalog endpoint).
# MLA1517_STRATUM_PASSWORD=x
# MLA1517_STRATUM_ENDPOINT=stratum.braiins.com:3333
# Per-pool settings (a failover pool uses its own, else the values above):
# MLA1517_VIABTC_USER=
# MLA1517_VIABTC_PASSWORD=
# MLA1517_VIABTC_ENDPOINT=btc.viabtc.io:3333
# Require TLS on bare endpoints (stratum+ssl:// always uses TLS).
# MLA1517_STRATUM_TLS=0

# --- Local Bitcoin node (optional chain-evidence source) -------------------
# Read-only bitcoind RPC. Remote URLs must be HTTPS; credentials are supplied
# separately (never inside the URL).
# PYTHIA_BITCOIN_RPC_URL=http://127.0.0.1:8332
# user:pass for Basic auth, or a .cookie file path instead:
# PYTHIA_BITCOIN_RPC_AUTH=
# PYTHIA_BITCOIN_RPC_COOKIE=/run/bitcoind/.cookie
# Require the node to be on this chain (main/test/testnet4/signet/regtest);
# startup fails closed on a mismatch so testnet state can't masquerade as mainnet.
# PYTHIA_BITCOIN_NETWORK=main

# --- Mining device ----------------------------------------------------------
# The MLA1517 register block (FPGA/UIO). Unset, the control app runs and the
# workers stay armed_no_device; set, they spawn and are supervised.
# MLA1517_MMIO_DEVICE=/dev/uio0
# Bridge-free mining: with no MMIO device, the mining worker drives the
# Execution Router itself. opencl requires a self-checked OpenCL device and
# refuses to start without one; cpu is the labelled CPU reference. Unset, only
# MLA1517_MMIO_DEVICE arms the miner. Salamander still needs the MMIO bridge.
# PYTHIA_EXECUTION_DEVICE=opencl
# PYTHIA_AUTOSTART_WORKERS=1
# SHA256d executor: auto (OpenCL when it passes self-check, else CPU), cpu, opencl.
# PYTHIA_EXECUTION_BACKEND=auto
# Longest a single search window may run before the policy re-plans.
# PYTHIA_MAX_WINDOW_SECONDS=2.0
# Legacy/base-coordinator traversal selector. Production PYTHIA precomputes the
# canonical 32-face -> 11D -> 600-vertex -> exact-Hilbert search and executes
# that complete itinerary. Hendrix/M32/11D tokens remain supported refinements
# and compatibility/reference routes; none replaces SHA256d/target truth.
# PYTHIA_NONCE_ORDER=hendrix
# OpenCL identity gate: refuse any device that is not a HYBA alias.
# HYBA_REQUIRE_HYBA=0
# HYBA_DEVICE_ALIAS=hyba-mla1517,hyba_mla1517,mla1517,hyba

# --- Control API --------------------------------------------------------------
# Local development only: allow control without a key when none is set.
# PYTHIA_ALLOW_UNAUTHENTICATED_CONTROL=0
# PYTHIA_HOST=0.0.0.0
# PYTHIA_PORT=3000
# PYTHIA_WEB_ROOT=dist/public
# The control API publishes its bound port here (merged with other writers'
# keys) so the Vite dev server proxies /api to it; PYTHIA_API_URL overrides.
# PYTHIA_ACTIVE_PORTS_FILE=/tmp/hyba_active_ports.json

# --- Autonomous codebase maintenance ----------------------------------------
# Repo context loads at backend startup. The full pytest-based repair cycle is
# operator-triggered by default; opt in to its expensive initial run explicitly.
# Every repair proposal remains review-only unless verified auto-apply is opted in.
# HYBA_STARTUP_SELF_HEALING_ENABLED=false
# HYBA_SKIP_STARTUP_SELF_HEALING=false
# HYBA_SELF_REPAIR_INTERVAL_S=0
# HYBA_SELF_REPAIR_LLM_ENABLED=false
# HYBA_SELF_REPAIR_LLM_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=
# HYBA_SELF_REPAIR_AUTO_APPLY=false

# --- Repo engineering assistant ---------------------------------------------
# The Intelligence-tab assistant runs in-repo (repo map, import audit, skill
# lookup, focused tests; read-only) and needs no model key. Asking it is a
# control request, so it takes EUCLID_ADMIN_API_KEY like any other.

# --- Durable state (put these on a volume in containers) ----------------------
# PYTHIA_RUNTIME_CONFIG=data/runtime_config.json
# PYTHIA_MINING_SESSION_PATH=data/mining_session.json
# PYTHIA_CAUSAL_LOG_PATH=data/causal_ledger.jsonl
# PYTHIA_AGENTIC_STATE_PATH=data/agentic_policy.json
# PYTHIA_INTELLIGENCE_DIR=data/intelligence

# --- TS surface only (server.ts / src/lib — NOT the Python runtime) ---
EUCLID_ADMIN_API_KEY=
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PYTHON_BIN=python
HYBA_KILL_SWITCH=false

# --- HYBA Security / AL HARAS (inject real keys from a secret manager) ---
AL_HARAS_SUBSCRIPTION_KEYS={}
AL_HARAS_ISSUER=hyba-subscriptions
AL_HARAS_DATA_DIR=/var/lib/hyba/al-haras
AL_HARAS_POLICY_VERSION=al-haras.policy.v1
AL_HARAS_CAPABILITY=hyba.security
AL_HARAS_MAX_PAYLOAD_BYTES=1048576
AL_HARAS_SUBSCRIPTION_URL=/contact?product=hyba-security
AL_HARAS_REQUIRE_INTELLIGENCE_EVIDENCE=true
