# Chronus environment variables (copy to .env; never commit real values).
#
# Every key below is read by code under src/ (enforced by
# tests/test_wiring_entrypoints.py). The previous template listed keys
# (TENANT_ID, ACCESS_TOKEN, REGION, LOG_LEVEL, LOG_FILE, SKIP_HEAVY_BENCHMARKS,
# ENABLE_MUTATION_TESTING) that no runtime code reads.

# --- API service (uvicorn chronus.service.app:app; Dockerfile target api-runtime)
# Stable JWT signing key (>=32 chars). Unset => random per-process key, tokens
# break on restart and the mining-admin authority stays closed.
CHRONUS_JWT_SECRET=
# Optional overrides (defaults: issuer https://auth.chronus.io, audience chronus-api).
# Leave commented unless set: an empty value overrides the default.
# CHRONUS_JWT_ISSUER=https://auth.chronus.io
# CHRONUS_JWT_AUDIENCE=chronus-api
# JSON object mapping bearer tokens to tenants, e.g. {"<token>": "tenant-a"}
CHRONUS_TENANT_TOKENS={}
# "production" makes missing durable custody paths fatal instead of in-memory.
CHRONUS_ENV=
CHRONUS_CORS_ORIGINS=
CHRONUS_ENABLE_DOCS=1
CHRONUS_WORKLOAD_DB_PATH=/var/lib/chronus/workloads.sqlite3
CHRONUS_PROCUREMENT_LEDGER=/var/lib/chronus/procurement_ledger.jsonl
CHRONUS_CIAAS_DURABLE_PATH=
# sqlite (default) | memory
CHRONUS_API_STATE_BACKEND=sqlite
# Optional PostgreSQL store (requires the [postgres] extra; schema via `alembic upgrade head`)
CHRONUS_STORE_BACKEND=
CHRONUS_DATABASE_URL=
# CHRONUS_EXECUTION_BASE_URL=
# Must stay unset/0 outside local development.
CHRONUS_DEV_JWT_PERMISSIVE=0

# --- Mining operator admission (/v1/mining/admin); see
# docs/security/mining-operator-admission-and-receipt-custody.md
CHRONUS_MINING_ADMIN_TENANT_ID=
CHRONUS_MINING_ADMIN_SUBJECTS=[]
CHRONUS_MINING_ADMIN_CUSTODY_PATH=

# --- Miner (chronus_live_miner.py; Dockerfile target miner-runtime, compose profile "miner")
# BRAIINS | VIABTC; host/port/user/password are read as MINING_<POOL>_*.
MINING_ACTIVE_POOL=BRAIINS
MINING_BRAIINS_HOST=
MINING_BRAIINS_PORT=
MINING_BRAIINS_USER=
MINING_BRAIINS_PASSWORD=
MINING_MAX_SECONDS=
MINING_NONCE_BATCH=65536
# Share submission stays disarmed unless explicitly approved.
CHRONUS_MINING_SUBMIT_ARMED=0
CHRONUS_MINING_APPROVAL_REFERENCE=
CHRONUS_MINING_ACCEPTED_SHARE_TARGET=0

# --- Runtime bounds (chronus.config.runtime_bounds; defaults shown)
CHRONUS_MAX_PAYLOAD_BYTES=1048576
CHRONUS_MAX_LATTICE_ELEMENTS=4096
