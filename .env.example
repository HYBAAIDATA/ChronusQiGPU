# Chronus environment variables (copy to .env; never commit real values).
#
# Every key below is read by code under src/ (enforced by
# tests/test_wiring_entrypoints.py). The previous template listed keys
# (TENANT_ID, ACCESS_TOKEN, REGION, LOG_LEVEL, LOG_FILE, SKIP_HEAVY_BENCHMARKS,
# ENABLE_MUTATION_TESTING) that no runtime code reads.

# --- API service (uvicorn chronus.service.app:app; Dockerfile target api-runtime)
# Optional keys are commented out: an empty assignment overrides the code default.
#
# Stable JWT signing key (>=32 chars). Unset => random per-process key, tokens
# break on restart and the mining-admin authority stays closed. docker-compose
# loads this file into the api container only; miner pool credentials live in
# .env.miner (see .env.miner.example) so they never reach the API container.
CHRONUS_JWT_SECRET=
# Issuer: the token *validator* only verifies `iss` when this is set (unset =>
# issuer verification disabled; minted tokens default to https://auth.chronus.io).
# Set it explicitly when issuer verification is required.
# CHRONUS_JWT_ISSUER=https://auth.chronus.io
# CHRONUS_JWT_AUDIENCE=chronus-api
# Static tenant credentials: JSON object of {"<tenant_id>": "<bearer-token>"}
# (tenant ID is the key, a strong random secret is the value; never use the
# tenant name as the credential). Both AuthService parsers read this layout.
# Leave commented until populated.
# CHRONUS_TENANT_TOKENS={"tenant-a": "<bearer-token>"}
# "production" makes missing durable custody paths fatal instead of in-memory.
# CHRONUS_ENV=production
# CHRONUS_CORS_ORIGINS=https://console.example.com
CHRONUS_ENABLE_DOCS=1
# Storage paths. Code defaults are writable relative paths (e.g.
# data/chronus-workloads.sqlite3); the container images/compose use /var/lib/chronus.
# CHRONUS_WORKLOAD_DB_PATH=/var/lib/chronus/workloads.sqlite3
# CHRONUS_PROCUREMENT_LEDGER=/var/lib/chronus/procurement_ledger.jsonl
# CHRONUS_CIAAS_DURABLE_PATH=/var/lib/chronus/ciaas.sqlite3
# sqlite (default) | memory
CHRONUS_API_STATE_BACKEND=sqlite
# Optional PostgreSQL store (requires the [postgres] extra; schema via `alembic upgrade head`)
# CHRONUS_STORE_BACKEND=postgres
# CHRONUS_DATABASE_URL=postgresql+asyncpg://user:password@host:5432/chronus
# CHRONUS_EXECUTION_BASE_URL=
# Must stay unset/0 outside local development.
CHRONUS_DEV_JWT_PERMISSIVE=0

# --- Mining operator admission (/v1/mining/admin); see
# docs/security/mining-operator-admission-and-receipt-custody.md
CHRONUS_MINING_ADMIN_TENANT_ID=
CHRONUS_MINING_ADMIN_SUBJECTS=[]
CHRONUS_MINING_ADMIN_CUSTODY_PATH=

# --- Runtime bounds (chronus.config.runtime_bounds; defaults shown)
CHRONUS_MAX_PAYLOAD_BYTES=1048576
CHRONUS_MAX_LATTICE_ELEMENTS=4096
# Largest local DMRG eigenproblem (2-site effective dimension) before refusing.
# CHRONUS_MAX_DMRG_LOCAL_DIM=8192

# --- THESEUS storage repair (chronus.storage.self_heal; docs/SELF_HEALING.md)
CHRONUS_SELF_HEALING=1
CHRONUS_SELF_HEALING_MAX_BYTES=262144
# theseus = repair in place on open/read; salamander = detect only, repair via the
# AL HARAS-authorised Salamander control plane (chronus.integration.salamander_theseus)
CHRONUS_SELF_HEALING_REPAIR=theseus
CHRONUS_SELF_HEALING_BACKFILL_LIMIT=1024
