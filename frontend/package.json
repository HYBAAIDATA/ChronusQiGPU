{
  "name": "pythia-operator-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "React operator frontend for the canonical PYTHIA Python/MLA1517 mining backend.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --outDir ../dist/public",
    "clean": "rimraf ../dist/public",
    "lint": "tsc --noEmit",
    "format": "prettier --write .",
    "test:ts": "vitest run",
    "test:ts:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.5",
    "d3": "^7.9.0",
    "express": "^4.21.0",
    "firebase": "^11.1.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.454.0",
    "morgan": "^1.10.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^2.15.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/d3": "^7.4.0",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "jsdom": "^26.1.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  }
