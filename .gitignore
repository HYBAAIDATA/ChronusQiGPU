# scratch build/output dir
.tmp_build/

# --- agent scratch / inspection output -------------------------------------
# Transient analysis dumps written to the repo root by tooling and agents.
# These are never source: they are regenerable output, so they are ignored
# rather than committed (and never force-added).
_tmp_*.py
_tmp_*/
_chronus_dump_ws/
_p8.out
_p8.err
_d.err
_wtest.py
_hasher_snap.py
_patch_hasher.py
_hyba_leftovers.txt
_FULL_BODIES.md
_dump/
_out/
_final/
_chunks/
_bodies/
_chapters/
_tiny/
_win/
_rp/
_inv_out/
_archive*/
# Agent working directory: git/diff/status dumps, *.done markers, pid files and
# one-off scan scripts. Only the hook config and skills are source; inventory
# files committed earlier stay tracked (ignore rules never untrack).
/.agents/*
!/.agents/hooks.json
!/.agents/skills/
/.agents_*.txt
# Local backup trees (superseded working copies) — not canonical source.
chronus_local_backup_*/
# Nested vendored clones / older-generation snapshots that must not be
# mistaken for the canonical packages (they contain their own .git or an
# entire duplicate subsystem tree).
hyba_data/
golden_quantum_package/
# Runtime registries written by the cognition plane.
var/
# Local devin environment descriptor (machine-specific paths).
# Narrowed to contents so the repo-level plugin declaration can be committed
# (Devin cloud discovers requiredPlugins from the cloned repo at session start).
.devin/*
!.devin/config.json
pytest_out.txt

# L-HRAS aethel storage roots (config.example.toml defaults)
aethel_store/
aethel_backup/
smoke-artifacts/

# Lean 4 build output
proofs/lean/.lake/

# --- Vendored workshop: external/sample-saas-multi-agents-workshop ----------
# The repo-wide rules above (data/, *.zip, *.log) would otherwise drop this
# vendored tree's sample inputs. Re-include them narrowly so the workshop stays
# self-contained. Provenance: upstream aws-samples/sample-saas-multi-agents-
# workshop @ 559fc55e6abfc79cd854ba35af30a7215d19f53e (MIT-0). See external/README.md.
!external/sample-saas-multi-agents-workshop/data/
!external/sample-saas-multi-agents-workshop/data/**
!external/sample-saas-multi-agents-workshop/**/*.zip
!external/sample-saas-multi-agents-workshop/**/*.log

# assurance-gate result artifacts (make gates / scripts/gate_runner.py)
results/

# adversarial-review evidence artifacts (eval_harness/artifacts/.gitignore keeps tmp/ out)
!eval_harness/artifacts/

# Chronus Virtual iGPU default embedded store
.chronus-virtual-igpu/
local-ci/
.hypothesis/
scratch_pseudocode.txt

# Re-include PHILOS Python contracts hidden by broad models/ ignore
!euclid/emergence/models/


# Provenance-preserving HYBA import recovery, not a vendored runtime clone.
!/recovery/hyba_data/
!/recovery/hyba_data/source/hyba_data/

# Preserve imported source directories, including nested package names.
!/recovery/hyba_data/source/**/
