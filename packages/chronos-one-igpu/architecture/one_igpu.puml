@startuml one_igpu
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()
title ONE iGPU — unified Chronos / MLA1517 architecture

Person(operator, "Operator", "Runs rendering, tensor, or internal mining workloads")
System_Ext(client, "Client GPU / Tensor Host", "Optional host accelerator")
System_Ext(pool, "External Pool", "Optional protocol endpoint")
System_Ext(hw, "Integrated GPU / ASIC / OpenCL", "Optional physical backend")

System_Boundary(one, "ONE iGPU substrate") {
  Container(core, "Exact mathematical core", "Python / C++ / Rust", "Fibonacci, Lucas, Cassini, Zeckendorf, Binet, Pisot")
  Container(pipe, "Six-stage datapath", "Fixed-width pipeline", "Lucas -> Cassini -> Zeckendorf -> PrimeROM -> Binet -> Pisot")
  Container(runtime, "Backend runtime", "Adapter registry", "CPU reference, integrated iGPU, host-GPU overlay; no silent fallback")
  Container(overlay, "Host overlay scheduler", "Tile planner", "Complete non-overlapping tiles across lanes")
  Container(store, "PRIME-DB", "SQLite WAL / content-addressed", "Verified objects, certificates, replay")
  Container(share, "Mining/share boundary", "Offline protocol adapter", "Custom Lucas shares, provenance, response binding")
  Container(evidence, "Evidence and receipts", "Content-addressed manifests", "Measured/modelled classification, backend binding")
}

Rel(operator, runtime, "dispatches")
Rel(core, pipe, "exact states")
Rel(pipe, runtime, "verified records")
Rel(runtime, hw, "optional backend")
Rel(runtime, client, "optional host-GPU overlay")
Rel(runtime, overlay, "tile work")
Rel(pipe, store, "verified objects")
Rel(pipe, share, "share candidates")
Rel(runtime, evidence, "receipts")
Rel(share, pool, "optional adapter")
Rel(operator, store, "put/get/verify")

note right of runtime
ONE iGPU means one logical substrate.
The physical execution backend is replaceable.
CPU reference is not presented as GPU hardware.
end note
@enduml
