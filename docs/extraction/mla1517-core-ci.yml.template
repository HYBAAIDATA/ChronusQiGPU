name: mla1517-core-ci
on:
  push:
    branches: [main]
    tags: ['v*']
  pull_request:
    branches: [main]
permissions:
  contents: read
  checks: write
  statuses: write
  packages: write
jobs:
  gates:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with: {fetch-depth: 0}
      - uses: actions/setup-python@v5
        with: {python-version: '3.12'}
      - run: pip install -e .
      - run: make assurance-gates
      - run: make -k gates || true
      - if: always()
        uses: actions/upload-artifact@v4
        with: {name: core-gate-results, path: results/}
      - if: always()
        run: make publish-checks
        env: {GITHUB_TOKEN: '${{ secrets.GITHUB_TOKEN }}'}
      - if: always()
        run: make gate-rollup
  release-package:
    needs: [gates]
    if: startsWith(github.ref, 'refs/tags/v')
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: {python-version: '3.12'}
      - run: pip install build && python -m build
      - uses: actions/upload-artifact@v4
        with: {name: mla1517-core-wheel, path: dist/}
