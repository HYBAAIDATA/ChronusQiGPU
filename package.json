{
  "name": "pythia-operator",
  "private": true,
  "version": "0.1.0",
  "description": "PYTHIA consolidated stack — Python control plane + frontend/ operator app.",
  "type": "module",
  "scripts": {
    "dev": "cd frontend && node ./node_modules/vite/bin/vite.js",
    "build": "cd frontend && node ./node_modules/vite/bin/vite.js build",
    "start": "python main.py --host 0.0.0.0 --port 3000 --web-root dist/public",
    "preview": "cd frontend && node ./node_modules/vite/bin/vite.js preview --outDir ../dist/public",
    "clean": "python -c \"import shutil; shutil.rmtree('dist', ignore_errors=True)\"",
    "lint": "cd frontend && node ./node_modules/typescript/bin/tsc --noEmit",
    "lint:py": "python -m flake8",
    "format": "cd frontend && node ./node_modules/prettier/bin/prettier.cjs --write .",
    "format:py": "python -m black .",
    "test:py": "python -m pytest tests/",
    "test:ts": "cd frontend && node ./node_modules/vitest/vitest.mjs run",
    "test:ts:cov": "cd frontend && node ./node_modules/vitest/vitest.mjs run --coverage",
    "test": "npm run lint && npm run build",
    "selftest": "python -X utf8 -m Intelligence.self_test"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
