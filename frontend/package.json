{
  "name": "pythia-operator-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "React operator frontend for the canonical PYTHIA Python/MLA1517 mining backend.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --outDir ../dist/public",
    "clean": "rimraf ../dist/public",
    "lint": "tsc --noEmit",
    "format": "prettier --write .",
    "test:ts": "vitest run",
    "test:ts:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^6.1.2",
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.0.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitest/coverage-v8": "^5.0.4",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.21.0"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  }
}
