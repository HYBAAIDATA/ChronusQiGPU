/* Bitcoin SHA256d, unchanged digest predicate. One owned nonce per work item. */
__constant uint K256[64]={0x428a2f98U,0x71374491U,0xb5c0fbcfU,0xe9b5dba5U,0x3956c25bU,0x59f111f1U,0x923f82a4U,0xab1c5ed5U,0xd807aa98U,0x12835b01U,0x243185beU,0x550c7dc3U,0x72be5d74U,0x80deb1feU,0x9bdc06a7U,0xc19bf174U,0xe49b69c1U,0xefbe4786U,0x0fc19dc6U,0x240ca1ccU,0x2de92c6fU,0x4a7484aaU,0x5cb0a9dcU,0x76f988daU,0x983e5152U,0xa831c66dU,0xb00327c8U,0xbf597fc7U,0xc6e00bf3U,0xd5a79147U,0x06ca6351U,0x14292967U,0x27b70a85U,0x2e1b2138U,0x4d2c6dfcU,0x53380d13U,0x650a7354U,0x766a0abbU,0x81c2c92eU,0x92722c85U,0xa2bfe8a1U,0xa81a664bU,0xc24b8b70U,0xc76c51a3U,0xd192e819U,0xd6990624U,0xf40e3585U,0x106aa070U,0x19a4c116U,0x1e376c08U,0x2748774cU,0x34b0bcb5U,0x391c0cb3U,0x4ed8aa4aU,0x5b9cca4fU,0x682e6ff3U,0x748f82eeU,0x78a5636fU,0x84c87814U,0x8cc70208U,0x90befffaU,0xa4506cebU,0xbef9a3f7U,0xc67178f2U};
inline uint ror256(uint x,uint n){return(x>>n)|(x<<(32-n));}
inline void init256(uint*h){h[0]=0x6a09e667U;h[1]=0xbb67ae85U;h[2]=0x3c6ef372U;h[3]=0xa54ff53aU;h[4]=0x510e527fU;h[5]=0x9b05688cU;h[6]=0x1f83d9abU;h[7]=0x5be0cd19U;}
inline void compress256(uint*h,uint*w){for(int i=16;i<64;i++){uint s0=ror256(w[i-15],7)^ror256(w[i-15],18)^(w[i-15]>>3);uint s1=ror256(w[i-2],17)^ror256(w[i-2],19)^(w[i-2]>>10);w[i]=w[i-16]+s0+w[i-7]+s1;}uint a=h[0],b=h[1],c=h[2],d=h[3],e=h[4],f=h[5],g=h[6],z=h[7];for(int i=0;i<64;i++){uint s1=ror256(e,6)^ror256(e,11)^ror256(e,25);uint ch=(e&f)^((~e)&g);uint t1=z+s1+ch+K256[i]+w[i];uint s0=ror256(a,2)^ror256(a,13)^ror256(a,22);uint maj=(a&b)^(a&c)^(b&c);uint t2=s0+maj;z=g;g=f;f=e;e=d+t1;d=c;c=b;b=a;a=t1+t2;}h[0]+=a;h[1]+=b;h[2]+=c;h[3]+=d;h[4]+=e;h[5]+=f;h[6]+=g;h[7]+=z;}
inline void nonce_sha256d(__global const uchar*prefix,uint nonce,uint*out){uchar message[128];for(int i=0;i<128;i++)message[i]=0;for(int i=0;i<76;i++)message[i]=prefix[i];for(int j=0;j<4;j++)message[76+j]=(uchar)(nonce>>(8*j));message[80]=0x80;message[126]=2;message[127]=0x80;uint h[8],w[64];init256(h);for(int block=0;block<2;block++){for(int i=0;i<16;i++){int p=block*64+i*4;w[i]=((uint)message[p]<<24)|((uint)message[p+1]<<16)|((uint)message[p+2]<<8)|message[p+3];}compress256(h,w);}for(int i=0;i<8;i++)w[i]=h[i];w[8]=0x80000000U;for(int i=9;i<15;i++)w[i]=0;w[15]=256;init256(h);compress256(h,w);for(int i=0;i<8;i++)out[i]=h[i];}
__kernel void chronos_sha256d(__global const uchar*prefix,__global const uint*nonces,__global uint*out,uint count){uint id=(uint)get_global_id(0);if(id>=count)return;uint digest[8];nonce_sha256d(prefix,nonces[id],digest);for(int i=0;i<8;i++)out[id*8+i]=digest[i];}
