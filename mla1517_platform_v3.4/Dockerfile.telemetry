# Build from the repository root (docker-compose.yml: context ..): the
# platform depends on the virtual quantum computer beside it.
FROM python:3.13-slim
WORKDIR /app
COPY turing_universal_quantum_computer /src/turing_universal_quantum_computer
COPY mla1517_platform_v3.4/pyproject.toml .
COPY mla1517_platform_v3.4/python ./python
RUN pip install --no-cache-dir /src/turing_universal_quantum_computer '.[telemetry]'
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/python \
    MLA1517_TELEMETRY_PATH=/dev/shm/mla1517_telemetry \
    MLA1517_PRIME_DB_DIR=/var/lib/mla1517/prime-db
RUN useradd --create-home --uid 10001 mla \
    && mkdir -p /var/lib/mla1517/prime-db \
    && chown -R mla:mla /app /var/lib/mla1517
USER mla
EXPOSE 8080
CMD ["uvicorn", "telemetry_daemon:app", "--host", "0.0.0.0", "--port", "8080"]