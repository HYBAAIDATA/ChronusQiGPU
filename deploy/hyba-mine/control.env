# HYBA Mine control. Edit and push to branch hyba-mine/control; the push runs
# .github/workflows/hyba-mine.yml, which acts on the Azure mining host.
#   HYBA_MINE_ACTION           campaign | status | stop | examine
#   HYBA_MINE_POOLS            pools in stage order, one block each (viabtc, braiins)
#   HYBA_MINE_MAX_RUN_SECONDS  upper bound for the whole campaign
HYBA_MINE_ACTION=campaign
HYBA_MINE_POOLS=viabtc,braiins
HYBA_MINE_MAX_RUN_SECONDS=14400
