@startuml igpu_architecture
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()
title PYTHIA iGPU / MLA1517 subsystem — component view (contract audit)

Person(operator, "Mining Operator", "Pool-connected mining; monitors telemetry")
System_Ext(pool, "Stratum Pool", "mining.notify / mining.submit")
System_Ext(opencl, "OpenCL Runtime + iGPU", "Integrated GPU (UMA, no PCIe)")
System_Ext(mla_dev, "MLA1517 Device", "MMIO control+vault; staged CSR + COMMIT_ACK")
System_Ext(shm, "PRIME-DB Ring", "POSIX /dev/shm seqlock ring, 64B descriptors")

System_Boundary(sys, "PYTHIA iGPU / MLA1517 subsystem") {

  Container_Boundary(igpu_core, "igpu — core") {
    Component(spec, "igpu.spec", "Contract loader", "mla1517_igpu_v1.json: 64B descriptor, warp 32, contract_version 1.0.0")
    Component(detect, "igpu.detect + igpu.runtime", "Census + allocation", "classify_integrated; KIND_BUFFER/SVM/HOST_FALLBACK — host RAM never labelled device memory")
    Component(engine, "igpu.engine + igpu.opencl_host", "OpenCL engine + punch host", "Singleton; HYBA-alias/measured-iGPU selection; atomic_min winner + mandatory CPU rescan")
    Component(device, "igpu.device + igpu.telemetry", "IGPU facade + telemetry", "grind() re-verifies sha256d<=target (sole accept authority); measured-only counters")
    Component(h4, "igpu.h4_* + kernels/*.cl", "H4 frame + kernels", "600-cell -> R^11 phi fold; coverage certificate; canonical .cl sources")
  }

  Container_Boundary(seam, "igpu.seam — contract seam") {
    Component(stypes, "seam.types + contract", "Result + seam_guard", "Ok|Err; 15 SeamError kinds; exception->error mapping, audit on unknown (S1)")
    Component(probe, "seam.probe + store", "Capability probe", "measured_hps Distribution, firmware_digest, attestation_chain, quarantine lifecycle")
    Component(kbuf, "seam.kernel + buffer + queue", "Dispatch + data plane", "idempotent dispatch; digest-verified buffers w/ AccessPolicy; backpressure at 64 in-flight")
    Component(froute, "seam.fleet + hybrid", "Routing", "KernelClass partition; declared fallback flag; route_gap audit")
    Component(audit, "seam.invariants + attest_* + zk", "Honesty + attestation", "P/B/K/Q/F/H/S invariant audit; CompositeAttestation merkle; k-of-n dissent quarantine; K5 snark = declared gap")
    Component(misc, "seam.reversible + gpu_scale + workflow", "Bennett + ladder + L0-L12", "ReversibilityClaim/Landauer; Lucas-ladder work items; L0..L12 pipeline + forgery-reject attestation")
  }

  Container_Boundary(mla, "mla1517 platform bridge") {
    Component(conn, "mla1517.connectors", "BackendConnector", "VALID_MODES incl. integrated_iGPU + host_gpu_overlay; CPU only if allow_cpu_fallback")
    Component(prime, "primedb_engine + hardware", "NativePrimeDB + MMIOBridge", "64B MLA1517State; Cassini-gate commit; stage CSR -> COMMIT_ACK; poll_vault_to_ring")
    Component(tr, "mla1517.telemetry_reader", "TelemetryReader (C10)", "magic 0x5A1A1517 / v3 / 960B; seqlock consistent snapshot")
    Component(hostq, "mla1517.host + quantum + accelerator", "HostGPUPlan + exact quantum", "Complete non-overlapping tiles; Q(sqrt2) exact amplitudes; AcceleratorUnavailable fail-closed")
    Component(salag, "salamander_engine + agentic_mining", "Supervisor + veto (S12.5/12.6)", "Seqlock sense -> stage -> commit -> ACK; 24-lane floor; observe-only; SupportViolation/safe_action")
    Component(aethel, "aethel.shm", "AethelQueue", "mmap seqlock 64B slots; magic/version on reopen; torn read discarded; Cassini gate + D7 route")
  }
}

Rel(operator, device, "grinds / report()")
Rel(misc, pool, "subscribe + submit_share", "stratum")
Rel(engine, opencl, "NDRange scan", "OpenCL")
Rel(device, prime, "64B descriptor")
Rel(prime, mla_dev, "CSR + COMMIT_ACK")
Rel(prime, shm, "poll_vault_to_ring")
Rel(aethel, shm, "mmap seqlock attach")
Rel(tr, mla_dev, "960B snapshot", "seqlock")
Rel(salag, prime, "stage/commit")
Rel(salag, tr, "sense()")
Rel(kbuf, detect, "capability + allocation")
Rel(froute, salag, "hybrid coordination")
Rel(misc, pool, "attested share submit")
Rel(h4, misc, "frame -> certificate")

Rel(engine, kbuf, "kernel dispatch")
Rel(probe, detect, "census")

@enduml

